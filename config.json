{
  "refresh_interval_seconds": 60,
  "endpoints": [
      {
        "url": "https://entappmon.fau.edu/api/v1/endpoints/statuses",
        "verify_ssl": true
      },
      {
        "url": "https://gatus.hpc.fau.edu/api/v1/endpoints/statuses",
        "verify_ssl": false        
      },
      {
        "url": "http://temperature.hpc.fau.edu/metrics",
        "type": "prometheus",
        "verify_ssl": false
      }      
  ],
  "filters": {
    "exclude": [
      "*test*",
      "*dev*"   
    ],
    "include": [
      {
        "pattern": "*crystalreports*",
        "group": "Reporting Services"
      },
      {
        "pattern": "*canvas*",
        "group": "Academic Applications"
      },
      {
        "pattern": "*radiator*",
        "group": "Radiator"
      }
    ]
  },
  "default_group_contacts": {
